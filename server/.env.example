# Server
PORT=4000

# x402 settlement mode: "simulated" (default, no funded wallet needed) or "live"
X402_MODE=simulated
FACILITATOR_URL=https://facilitator.goplausible.xyz
ALGOD_URL=https://testnet-api.algonode.cloud

# Base64 encoded Algorand secret keys. Left empty, ephemeral accounts are generated on boot.
AGENT_PRIVATE_KEY=
MERCHANT_PRIVATE_KEY=

# Agent budget policy
MAX_PER_REQUEST_USD=0.05
MAX_DAILY_USD=2
AGENT_STARTING_BALANCE_USD=5

# Optional: enables OpenAI tool-calling orchestration instead of the deterministic planner
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
